# Safe defaults: do not enable live trading during the hackathon.
EXECUTION_MODE=simulated
LIVE_TRADING_ENABLED=false

# Optional providers; leave blank until verified locally.
GEMINI_API_KEY=
CRYPTOPANIC_AUTH_TOKEN=
CRYPTOQUANT_API_KEY=

# OKX CLI manages its own credential storage; never commit credentials.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
